# SDPA on GPU: data types, masks, key layouts, head sizes, GQA and LLM shapes,
# forward and backward.

########################################
# Forward: head sizes and GQA          #
########################################

--reset
--dt=f16
--scale=div
--ktag=abcd,abdc
--mask=none,buffer_1d,buffer_2d
--mdt=f16,f32
--match=HeadSize
--batch=shapes_basic
--match=Gqa
--batch=shapes_basic

--reset
--dt=bf16
--scale=div
--ktag=abcd,abdc
--match=HeadSize
--mdt=bf16
--mask=buffer_1d,buffer_2d
--batch=shapes_basic

########################################
# Forward: LLM                         #
########################################

--reset
--dt=f16
--scale=div
--ktag=abdc
--mask=buffer_2d
--mdt=f16
--batch=shapes_llm

########################################
# Backward: f16, all mask kinds        #
########################################

--reset
--dir=BWD_D
--scale=div
--dt=f16
--ktag=abcd,abdc
--match=Mha
--mask=none,causal_top_left,causal_bottom_right
--batch=shapes_basic
--mask=buffer_2d,buffer_1d
--mdt=f16
--batch=shapes_basic

########################################
# Backward: bf16 and f32               #
########################################

--reset
--dir=BWD_D
--scale=div
--dt=bf16
--ktag=abcd,abdc
--match=Mha
--mask=causal_top_left
--batch=shapes_basic

--reset
--dir=BWD_D
--scale=div
--dt=f32
--match=Mha
--mask=none,causal_top_left
--batch=shapes_basic

########################################
# Backward: seq 4096                   #
########################################

--reset
--dir=BWD_D
--scale=div
--dt=f32,f16
--match=Seq4096
--mask=none,causal_top_left
--batch=shapes_basic

########################################
# Backward: GQA and LLM prefill        #
########################################

--reset
--dir=BWD_D
--scale=div
--dt=f16
--ktag=abcd,abdc
--match=Gqa
--mask=none,causal_top_left
--batch=shapes_basic

--reset
--dir=BWD_D
--scale=div
--dt=f16,bf16
--ktag=abcd,abdc
--match=Prefill
--mask=causal_top_left
--batch=shapes_llm

########################################
# Dropout: no offset (legacy) and with offset, Sk aligned and unaligned
# (127, 129, 385: not a multiple of the dropout group size; 132: multiple of
# 4 only; 257: Q and K both odd)
########################################

--reset
--dt=f16
--scale=div
--attr-dropout=0.1:12345:undef,0.1:12345:undef:777,0.5:99:undef:4294967298
2x4x256x64:2x4x64x256:2x4x256x64
2x4x256x64:2x4x64x127:2x4x127x64
2x4x256x64:2x4x64x129:2x4x129x64
2x4x256x64:2x4x64x132:2x4x132x64
2x4x256x64:2x4x64x385:2x4x385x64
2x3x257x64:2x3x64x257:2x3x257x64

--reset
--dir=BWD_D
--dt=f16,bf16
--scale=div
--attr-dropout=0.1:12345:undef,0.1:12345:undef:777,0.5:99:undef:4294967298
2x4x256x64:2x4x64x256:2x4x256x64
2x4x256x64:2x4x64x127:2x4x127x64
2x4x256x64:2x4x64x129:2x4x129x64
2x4x256x64:2x4x64x132:2x4x132x64
2x4x256x64:2x4x64x385:2x4x385x64
2x3x257x64:2x3x64x257:2x3x257x64
