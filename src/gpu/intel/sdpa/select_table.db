// select.cpp. Written by scripts/sdpa_tuner/bake_fit.py from the sweeps
// described in scripts/sdpa_tuner/README.md; do not edit by hand.
//
// Each entry is a fwd_table_entry_t: the fwd_key_t members in declaration
