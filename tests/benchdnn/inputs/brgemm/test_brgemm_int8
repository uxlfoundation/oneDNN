# u8 src
## Bias check
--reset
--brgemm-attr=,use_uker:1
--dt=u8:s8:f32,u8:s8:bf16,u8:s8:s32,u8:s8:u8,u8:s8:s8
--bia_dt=f32,bf16,s32,u8,s8
--batch=option_set_int8

## Sum check
--reset
--brgemm-attr=,use_uker:1
--dt=u8:s8:f32,u8:s8:bf16,u8:s8:s32,u8:s8:u8,u8:s8:s8
--beta=0,1
--batch=option_set_int8

## Attributes check
--reset
--brgemm-attr=,use_uker:1
--dt=u8:s8:f32,u8:s8:u8
--attr-post-ops=,sum:2,relu
--attr-scales=,src:common:0.5,wei:per_oc,dst:common:5,src:common:0.5+wei:per_oc+dst:common:5
--attr-zero-points=,src:common:-2,src:common:128+dst:common:-1
--batch=option_set_int8

## Separate cases for non-default alpha check
--reset
--alpha=2
--dt=u8:s8:f32
--batch=shapes_2d_no_tail_int8

# s8 src
## Bias check
--reset
--brgemm-attr=,use_uker:1
--dt=s8:s8:f32,s8:s8:bf16,s8:s8:s32,s8:s8:u8,s8:s8:s8
--bia_dt=f32,bf16,s32,u8,s8
--batch=option_set_int8

## Sum check
--reset
--brgemm-attr=,use_uker:1
--dt=s8:s8:f32,s8:s8:bf16,s8:s8:s32,s8:s8:u8,s8:s8:s8
--beta=0,1
--batch=option_set_int8

## Attributes check
--reset
--brgemm-attr=,use_uker:1
--dt=s8:s8:s32,s8:s8:s8
--attr-post-ops=,sum:2,relu
--attr-scales=,src:common:0.5,wei:per_oc,dst:common:5,src:common:0.5+wei:per_oc+dst:common:5
--attr-zero-points=,src:common:-2,src:common:128+dst:common:-1
--batch=option_set_int8

## Separate cases for non-default alpha check
--reset
--alpha=2
--dt=s8:s8:f32
--batch=shapes_2d_no_tail_int8

## Skip-acc feature
--reset
--brgemm-attr=generate_skip_accumulation:1,generate_skip_accumulation:1+use_uker:1
--beta=0,1
--bia_dt=f32
--dt=u8:s8:u8
--batch=option_set_int8

## Limited full stack check
--reset
--brgemm-attr=,use_uker:1
--dt=s8:s8:s8
--attr-post-ops=sum:2+relu
--attr-scales=src:common:0.5+wei:per_oc+dst:common:5
--attr-zero-points=,src:common:128+dst:common:-1
--bia_dt=f32,s8
--batch=option_set_int8

# u8 wei
## Limited check (u8 wei is mostly unsupported)
--reset
--brgemm-attr=,use_uker:1
--dt=s8:u8:f32,u8:u8:s32
--bia_dt=f32,bf16,s32,u8,s8
--batch=option_set_int8

# ukernel wtag support
--reset
--wtag=ba
--dt=u8:s8:f32,s8:s8:s32,u8:u8:u8
--batch=option_set_int8

# Plain A with K=8 and an N tail.
--reset --dt=u8:s8:s32 --brgemm-attr=use_mmla:1 6x8:8x33

# Packed A with N/K tails, beta, source ZP, and LDB > 64.
--reset --dt=u8:s8:s32 --beta=1 --attr-zero-points=src:common:3 --brgemm-attr=use_mmla:1+use_mmla_packed_a:1 10x63:63x81

# Plain A with large row offsets and non-unit alpha/beta.
--reset --dt=u8:s8:f32 --alpha=0.5 --beta=2 --ld=20000:16:16 --brgemm-attr=use_mmla:1 5x16:16x16

# Bias, scales, sum, eltwise, conversion, and destination tails.
--reset --dt=u8:s8:u8 --bia_dt=f32 --attr-post-ops=sum:2+relu --attr-scales=src:common:0.5+wei:per_oc+dst:common:5 --brgemm-attr=use_mmla:1 5x15:15x17
