# Shapes for MXFP8 (dynamic_mx) matmul testing - plain form (no --reset),
# intended to be used via --batch= from harness_matmul_dynamic_mx.
# Constraints: K % 32 == 0, N % 32 == 0 (mx group size along K and N).
# This is the "small" variant: M, K, N <= 512; 3D batch <= 16,
# 4D total batch <= 32.
#
# Split by rank so that rank-dependent options (e.g. --bia_mask) can target
# a single rank.
--batch=shapes_dynamic_mx_plain_small_2d
--batch=shapes_dynamic_mx_plain_small_3d
--batch=shapes_dynamic_mx_plain_small_4d
