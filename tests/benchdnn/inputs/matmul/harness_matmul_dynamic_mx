--reset
--skip-impl=ref
--dt=f8_e4m3:f8_e4m3:f32
--stag=any --wtag=any --dtag=any
--bia-dt=f32,f8_e4m3
--attr-scales=src:per_tensor:e8m0:1x32+wei:per_tensor:e8m0:32x1
--attr-post-ops=,relu
--bia_mask=2 --batch=shapes_dynamic_mx_plain_small_2d
--bia_mask=4 --batch=shapes_dynamic_mx_plain_small_3d
--bia_mask=8 --batch=shapes_dynamic_mx_plain_small_4d

