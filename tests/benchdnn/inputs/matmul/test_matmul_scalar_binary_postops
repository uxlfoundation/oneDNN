# Focused correctness/performance coverage for scalar f32/BF16 binary post-ops
# in x64 BRGEMM matmul kernels. Use --mode=C or --mode=P with this batch.

--reset
--dt=f32
--stag=ab --wtag=ab --dtag=ab

# Common scalar arithmetic, including N and M tails.
--attr-post-ops=mul:f32:common
32x64:64x37 7x127:127x65 2x63:63x17
--attr-post-ops=add:f32:common
32x64:64x37 7x127:127x65

# Multiple scalar post-ops must keep RHS pointers distinct or reload them
# sequentially without changing RHS argument ordering.
--attr-post-ops=mul:f32:common+add:f32:common
32x64:64x37 7x127:127x65

# Eligible f32 direct arithmetic mixed with an ineligible scalar s32 op.
--attr-post-ops=mul:f32:common+add:s32:common
32x64:64x37 7x127:127x65

# Non-scalar and unsupported-dtype RHS operations remain on the generic path.
--attr-post-ops=add:f32:per_oc
32x64:64x37
--attr-post-ops=add:s32:common
32x64:64x37

# One RHS after eltwise is still direct. Select has two RHS operands;
# PReLU has one RHS operand but retains generic arithmetic.
--attr-post-ops=relu+sub:f32:common,div:f32:common,min:f32:common,max:f32:common
7x127:127x65
--attr-post-ops=select:f32:common,prelu:per_oc
7x127:127x65

# GEMV's IR emitter explicitly retains its array-only transport.
--attr-post-ops=mul:f32:common,mul:f32:common+add:f32:common
1x64:64x37 32x64:64x1

# AMX and its tail kernels share the descriptor-fixed RHS transport.
--dt=bf16:bf16:f32
--attr-post-ops=mul:f32:common,mul:f32:common+add:f32:common,add:s32:common
32x64:64x37

# BF16 scalar conversion is shared within one injector vector range.
# Exercise all eligible arithmetic operations, including M/N tails.
--dt=bf16:bf16:bf16
--attr-post-ops=mul:bf16:common,add:bf16:common,sub:bf16:common,div:bf16:common,min:bf16:common,max:bf16:common
32x64:64x32 7x127:127x65

# Distinct BF16 RHS values and mixed operations must be reloaded independently.
--attr-post-ops=mul:bf16:common+add:bf16:common,mul:bf16:common+add:f32:common,relu+mul:bf16:common
7x127:127x65

# BF16 non-scalar, comparison and select operations retain generic handling.
--attr-post-ops=mul:bf16:per_oc,ge:bf16:common,select:bf16:common
7x127:127x65

# MFDNN-15380: one scalar BF16 RHS, per-head Q/K strides, and AMX N/M tails.
--reset
--dt=bf16:bf16:bf16
--strides=768x1:1x768:
--attr-post-ops=mul:bf16:0
197x64:64x197
