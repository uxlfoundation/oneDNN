--reset

--inplace=true,false
--alg=ADD,MUL,MAX,MIN,DIV,SUB,GE,GT,LE,LT,EQ,NE,SELECT
--stag=abx:any,axb:any

--ddt=f32 --sdt=f32:f32
--batch=shapes_ci

--ddt=bf16 --sdt=bf16:bf16
--batch=shapes_ci

--ddt=bf16 --sdt=bf16:f32
--batch=shapes_ci

--ddt=f16 --sdt=f16:f16
--batch=shapes_ci

--ddt=s8 --sdt=s8:s8
--batch=shapes_ci

--ddt=u8 --sdt=u8:u8
--batch=shapes_ci

--ddt=s32 --sdt=s32:s32
--batch=shapes_ci

# A separate section with a single alg to avoid tons of same test cases
--alg=ADD
--attr-post-ops=, \
                sum:0.5, \
                linear:2:0.125, \
                add:f32, \
                mul:s8:per_oc+sum:0.25+relu:-0.01+add:f32:per_tensor
--attr-scales=,src:common:0.5+src1:common:0.25

--ddt=f32 --sdt=f32:f32
--batch=shapes_ci

--ddt=bf16 --sdt=bf16:bf16
--batch=shapes_ci

--ddt=f16 --sdt=f16:f16
--batch=shapes_ci

--ddt=s8 --sdt=s8:s8
--batch=shapes_ci

--ddt=u8 --sdt=u8:u8
--batch=shapes_ci

--ddt=s32 --sdt=s32:s32
--batch=shapes_ci

# A per-channel binary post-op operand is read from the wrong offset when every
# dimension inside the channel has extent 1 and the channel is not the innermost
# one: the plain layout then reports the same strides as a channel-innermost
# layout, `get_op_type()` resolves it as `n_spatial_c`, and the post-op
# broadcast takes the path that assumes a tight channel. Two shapes cover it,
# one three-dimensional and one where a spatial extent other than the last is
# the only one left above 1.
--reset --sdt=f32:f32 --ddt=f32
--attr-post-ops=add:f32:per_oc
--batch=shapes_per_oc_degenerate

--reset --sdt=f32:f32 --ddt=f32
--attr-post-ops=mul:f32:per_oc
--batch=shapes_per_oc_degenerate
