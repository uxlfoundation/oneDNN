--dt=f16:u8:f16
--wtag=abc
--attr-fpmath=f16:true
--attr-scales=wei:5:f16
--attr-zero-points=wei:5:u8
--grouped=0:32:balanced
256x128:32x128x64
512x128:32x128x64
1024x128:32x128x64
2048x128:32x128x64
4096x128:32x128x64

# Post-ops:
# swish + binary_mul (per-row/dense/grouped), all eltwise
# algorithms, chains (grouped + dense binary_mul)
--reset
--dt=f32:f32:f32,bf16:bf16:bf16,f16:f16:f16
--wtag=abc
--grouped=0:4:balanced
--attr-post-ops=eltwise_swish:1.0,mul:f32:1,mul:f16:1,mul:bf16:1,mul:f32:3:grouped,mul:f16:3:grouped,mul:bf16:3:grouped,eltwise_relu,eltwise_relu:0.5,eltwise_tanh,eltwise_elu:1.0,eltwise_square,eltwise_abs,eltwise_sqrt,eltwise_linear:2.0:1.0,eltwise_soft_relu:1.0,eltwise_logistic,eltwise_exp,eltwise_gelu_tanh,eltwise_log,eltwise_clip:0.0:6.0,eltwise_clip_v2:0.0:6.0,eltwise_pow:1.0:3.0,eltwise_gelu_erf,eltwise_round,eltwise_mish,eltwise_hardswish:0.166667:0.5,eltwise_hardsigmoid:0.2:0.5,mul:f16:3:grouped+mul:f32:1,eltwise_swish:1.0+mul:f16:3:grouped+mul:f32:1,eltwise_swish:1.0+mul:f32:1,eltwise_swish:1.0+mul:f16:1
32x64:4x64x32

# Post-ops + bias: binary_mul per-row and grouped with bias
--reset
--dt=f32:f32:f32,bf16:bf16:bf16
--wtag=abc
--grouped=0:4:balanced
--bia-dt=f32 --bia_mask=2
--attr-post-ops=mul:f32:1,mul:f32:3:grouped,mul:bf16:3:grouped,mul:f16:3:grouped
